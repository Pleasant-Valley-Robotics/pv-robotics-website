---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import TeamCard from '../components/TeamCard.astro';
import CallToAction from '../components/CallToAction.astro';
import { mentors, pathways, programs } from '../data/site';

const teams = (await getCollection('teams')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="About" description="What Pleasant Valley FIRST is, the FTC and FRC programs, related PVHS classes, and our mentors.">
  <PageHero eyebrow="About us" title="What is Pleasant Valley FIRST?">
    PVCSD FIRST is every student, mentor and faculty member who takes part in <em>FIRST</em>'s robotics programs through the school. Robotics is more than building a robot. Students learn engineering alongside problem solving, teamwork and media skills they'll use every day.
  </PageHero>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Programs</span>
        <h2>What can you participate in?</h2>
      </div>
      <div class="grid grid--2">
        {programs.map((p) => (
          <div class="card">
            <span class="code">{p.code}</span>
            <h3>{p.name}</h3>
            <p class="muted">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our teams</span>
        <h2>Find your team</h2>
      </div>
      <div class="grid grid--3">
        {teams.map((team) => <TeamCard team={team} />)}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Classes at PVHS</span>
        <h2>Pathways that pair with robotics</h2>
        <p class="lede">Pleasant Valley's applied science courses build the same skills our teams use in the shop and at competition.</p>
      </div>
      <div class="grid grid--3">
        {pathways.map((p) => (
          <div class="card">
            <h3>{p.name}</h3>
            <ul class="courses">
              {p.courses.map((c) => <li>{c}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Mentors & coaches</span>
        <h2>The adults in the room</h2>
        <p class="lede">Volunteers and staff who bring engineering, machining, business and media experience to our students.</p>
      </div>
      <ul class="mentors">
        {mentors.map((m) => (
          <li class="card">
            <span class="initials" aria-hidden="true">{m.name.split(' ').map((w) => w[0]).join('')}</span>
            <div>
              <strong>{m.name}</strong>
              <span class="muted">{m.role}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CallToAction />
</Base>

<style>
  .code {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.5rem;
    line-height: 1;
    margin-bottom: 0.5rem;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .courses { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; color: var(--muted); }
  .courses li { padding-left: 1.1rem; position: relative; }
  .courses li::before { content: ''; position: absolute; left: 0; top: 0.7em; width: 6px; height: 6px; border-radius: 50%; background: var(--cyan); }
  .mentors {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
  }
  .mentors li { display: flex; align-items: center; gap: 1rem; padding: 1.1rem 1.25rem; }
  .mentors strong, .mentors span { display: block; }
  .initials {
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: grid !important;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    background: var(--grad);
    color: #050816;
  }
</style>
