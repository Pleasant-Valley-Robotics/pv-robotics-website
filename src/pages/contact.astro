---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';

const teams = (await getCollection('teams')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Contact" description="Email and social media for Everything That's Radical, Deviation From the Norm and No Limit Robotics.">
  <PageHero eyebrow="Contact" title="Let's talk robots.">
    Interested in what we do? Want to mentor a team, sponsor us or join? Reach out to the team directly or send a general note.
  </PageHero>

  <section class="section">
    <div class="container grid grid--3">
      {teams.map(({ data: t, id }) => (
        <div class="card team" style={`--accent: ${t.accent}`}>
          <div class="logo" style={`background: ${t.logoBg}`}><img src={t.logo} alt="" loading="lazy" /></div>
          <span class="eyebrow">{t.program} #{t.number}</span>
          <h3><a href={`/${id}`}>{t.name}</a></h3>
          {t.email && <p><a href={`mailto:${t.email}`}>{t.email}</a></p>}
          <ul>
            {t.socials.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="section section--alt">
    <div class="container general">
      <div>
        <h2>General inquiries</h2>
        <p class="lede">Mentoring, sponsorship, media or anything else.</p>
      </div>
      <a class="btn btn--primary" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
    </div>
  </section>
</Base>

<style>
  .team { border-top: 3px solid var(--accent); display: flex; flex-direction: column; }
  .team .eyebrow { color: var(--accent); margin-bottom: 0.4rem; }
  .team h3 a { color: var(--text); text-decoration: none; }
  .team h3 a:hover { color: var(--accent); }
  .team p { overflow-wrap: anywhere; }
  .logo { height: 120px; background: #fff; border-radius: 12px; display: flex; align-items: center; justify-content: center; padding: 0.9rem; margin-bottom: 1.25rem; }
  .logo img { max-width: 100%; max-height: 100%; object-fit: contain; }
  ul { list-style: none; padding: 0; margin: auto 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  ul a { display: inline-block; border: 1px solid var(--border); border-radius: 999px; padding: 0.3rem 0.85rem; text-decoration: none; }
  .general { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .general .lede { margin-bottom: 0; }
  .general .btn { overflow-wrap: anywhere; }
</style>
