---
import { site } from '../data/site';
---

<section class="section">
  <div class="container">
    <div class="cta">
      <div>
        <span class="eyebrow">Get involved</span>
        <h2>Build something with us.</h2>
        <p class="lede">
          Students, mentors, sponsors and families all have a place here. Join a team, share your expertise, or help fund the next robot.
        </p>
      </div>
      <div class="btn-row">
        <a class="btn btn--primary" href="/contact">Contact the teams</a>
        <a class="btn btn--ghost" href="/sponsors">Become a sponsor</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    display: grid;
    gap: 2rem;
    align-items: end;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: 28px;
    border: 1px solid var(--border);
    background:
      radial-gradient(600px 300px at 0% 0%, rgb(139 92 246 / 0.35), transparent 70%),
      radial-gradient(600px 300px at 100% 100%, rgb(34 211 238 / 0.25), transparent 70%),
      var(--surface);
  }
  .cta .lede { margin-bottom: 0; }
  .btn-row { justify-content: flex-start; }
  @media (min-width: 800px) { .btn-row { justify-content: flex-end; } }
</style>
