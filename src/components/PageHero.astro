---
interface Props { eyebrow: string; title: string }
const { eyebrow, title } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    {Astro.slots.has('default') && <p class="lede"><slot /></p>}
  </div>
</section>

<style>
  .page-hero {
    padding-block: clamp(64px, 10vw, 120px) clamp(48px, 7vw, 80px);
    background:
      radial-gradient(700px 360px at 10% 0%, rgb(139 92 246 / 0.35), transparent 70%),
      radial-gradient(520px 320px at 100% 0%, rgb(34 211 238 / 0.18), transparent 70%);
  }
  .lede { margin-bottom: 0; }
</style>
