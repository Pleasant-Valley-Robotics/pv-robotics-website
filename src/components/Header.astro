---
import { nav, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="header">
  <div class="container bar">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <img src="/images/brand/pv-logo.png" alt="" width="40" height="40" />
      <span>PV <span class="gradient-text">Robotics</span></span>
    </a>

    <!-- A <details> menu works on phones without any JavaScript. -->
    <details class="menu">
      <summary aria-label="Menu">
        <span class="burger" aria-hidden="true"></span>
      </summary>
      <nav aria-label="Main">
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(7 11 31 / 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 68px; }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
  }
  .brand img { width: 40px; height: 40px; border-radius: 50%; background: #fff; }

  .menu summary { list-style: none; cursor: pointer; padding: 0.6rem; border-radius: 10px; }
  .menu summary::-webkit-details-marker { display: none; }
  .burger, .burger::before, .burger::after {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    position: relative;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .burger::before, .burger::after { content: ''; position: absolute; left: 0; }
  .burger::before { top: -7px; }
  .burger::after { top: 7px; }
  .menu[open] .burger { background: transparent; }
  .menu[open] .burger::before { transform: translateY(7px) rotate(45deg); }
  .menu[open] .burger::after { transform: translateY(-7px) rotate(-45deg); }

  nav ul { list-style: none; margin: 0; padding: 0; }
  nav a {
    display: block;
    color: var(--muted);
    text-decoration: none;
    font-weight: 500;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
  }
  nav a:hover, nav a[aria-current='page'] { color: var(--text); background: rgb(255 255 255 / 0.06); }

  @media (max-width: 899px) {
    .menu nav {
      position: absolute;
      left: 0;
      right: 0;
      top: 68px;
      background: var(--bg-2);
      border-bottom: 1px solid var(--border);
      padding: 0.75rem 16px 1.25rem;
    }
    nav a { font-size: 1.1rem; padding: 0.75rem 1rem; }
  }

  @media (min-width: 900px) {
    .menu summary { display: none; }
    nav ul { display: flex; gap: 0.25rem; }
  }
</style>

<script>
  // On desktop the <details> must stay open so the nav is visible.
  const menu = document.querySelector<HTMLDetailsElement>('.menu');
  const mq = window.matchMedia('(min-width: 900px)');
  const sync = () => { if (menu) menu.open = mq.matches; };
  sync();
  mq.addEventListener('change', sync);
</script>
